{
  "version": 2,
  "installCommand": "npm install && npm install --prefix packages/frontend",
  "buildCommand": "npm run build --prefix packages/frontend",
  "outputDirectory": "packages/frontend/dist",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
